# Copy to /etc/monetio-worker.env (owner root, mode 600). Never commit real values.
POSTGRES_URL_NON_POOLING=postgres://user:password@host:5432/postgres
# Optional: scheduler tick, default 30000 ms.
# WORKER_TICK_MS=30000
# Healthchecks.io ping URL per job: HEALTHCHECK_URL_<JOB_NAME_IN_UPPER_SNAKE_CASE>.
HEALTHCHECK_URL_DB_PING=
