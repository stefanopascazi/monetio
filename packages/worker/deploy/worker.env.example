# Copy to /etc/monetio-worker.env (owner root, mode 600). Never commit real values.
POSTGRES_URL_NON_POOLING=postgres://user:password@host:5432/postgres
# Optional: scheduler tick, default 30000 ms.
# WORKER_TICK_MS=30000
# Healthchecks.io ping URL per job: HEALTHCHECK_URL_<JOB_NAME_IN_UPPER_SNAKE_CASE>.
HEALTHCHECK_URL_DB_PING=
HEALTHCHECK_URL_BACKUP=

# Error tracking (optional): DSN of the Sentry project "monetio-worker".
SENTRY_DSN=

# Daily backup (#48): leave BACKUP_* empty to disable it.
BACKUP_REMOTE=r2:monetio-backups
# age public key; the private key stays off the VPS (password manager + GitHub secret).
BACKUP_AGE_RECIPIENT=age1...
# Cloudflare R2 remote for rclone (token: Object Read & Write on the backup bucket only).
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ACL=private
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true

# Web push (#28): leave VAPID_* empty to disable the push-deliver job.
# Generate once with: npx web-push generate-vapid-keys
# The public key also goes to Vercel as NEXT_PUBLIC_VAPID_PUBLIC_KEY (same value).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
HEALTHCHECK_URL_PUSH_DELIVER=
HEALTHCHECK_URL_NOTIFY_EVENTS=
