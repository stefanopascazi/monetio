{
  "name": "monetio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "stack:dev": "node scripts/docker/compose.ts -f docker-compose.dev.yml up -d",
    "stack:up": "node scripts/docker/compose.ts up -d --build",
    "stack:down": "node scripts/docker/compose.ts down",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && npm run worker:typecheck",
    "worker:typecheck": "tsc -p packages/worker",
    "worker:build": "node packages/worker/build.ts",
    "ds:tokens": "node packages/ui/scripts/build-tokens.ts",
    "ds:artifact": "node packages/ui/scripts/build-tokens.ts && node packages/ui/scripts/build-artifact.ts",
    "db:migrate": "node scripts/db/migrate.ts",
    "db:import": "node scripts/import/run-import.ts",
    "auth:invite": "node scripts/dev/invite.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@sentry/nextjs": "^11.12.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@vercel/analytics": "^2.0.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.460.0",
    "next": "16.4.5",
    "postgres": "^4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@sentry/node": "^11.12.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.10",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "web-push": "^3.6.7"
  }
}
